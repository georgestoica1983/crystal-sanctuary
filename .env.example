# Gemini API key for the AI Garden Crafter (Expansion perk).
# Optional: without it, crafted gardens fall back to the deterministic generator.
# The Daily never uses Gemini.
GEMINI_API_KEY=

# Supabase: daily leaderboard (public anon key) + purchase restore magic links.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used to read/write purchases and Crafter quota.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe: one-time $3.99 Expansion (server only).
STRIPE_SECRET_KEY=
# Price ID of the one-time $3.99 product (price_...)
STRIPE_PRICE_ID=
# Signing secret of the webhook endpoint pointing at /api/stripe-webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Optional: public site URL used for Stripe success/cancel redirects
# (defaults to the request origin).
NEXT_PUBLIC_APP_URL=

# Tester round (optional, public): ☰ → Send feedback opens this link (e.g. a Google Form)
NEXT_PUBLIC_FEEDBACK_URL=
# Anonymous play tracking with PostHog (free). Leave empty to turn tracking off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
